@startuml
skinparam defaultFontSize 10
skinparam classAttributeIconSize 0
hide empty members

title Core Class Diagram

interface "RaftRpcHandler" as Handler {
    +handleRequestVote(req): RequestVoteResponse
    +handleAppendEntries(req): AppendEntriesResponse
    +handleInstallSnapshot(req): InstallSnapshotResponse
    +handlePreVote(req): PreVoteResponse
    +handleTimeoutNow(req): TimeoutNowResponse
}

interface "RaftTransport" as Transport {
    +requestVote(req): CompletableFuture
    +appendEntries(req): CompletableFuture
    +installSnapshot(req): CompletableFuture
    +preVote(req): CompletableFuture
    +timeoutNow(req): CompletableFuture
    +close()
}

interface "RaftTransportFactory" as Factory {
    +connect(address): RaftTransport
}

interface "RaftTransportServer" as TServer {
    +start()
    +close()
}

interface "RaftStorage" as Storage {
    +getCurrentTerm(): long
    +getVotedFor(): String
    +setTermAndVote(term, votedFor)
    +appendEntries(entries)
    +appendEntriesDeferSync(entries): CompletableFuture
    +truncateFrom(index)
    +getLogEntry(index): LogEntry
    +getLastLogIndex(): long
    +saveSnapshotAndCompact(snapshot)
    +getSnapshot(): Snapshot
}

interface "StateMachine" as SM {
    +apply(command): byte[]
    +takeSnapshot(): byte[]
    +restoreSnapshot(data)
}

class "RaftNode" as Node {
    -role: ServerRole
    -currentLeaderId: String
    -commitIndex: AtomicLong
    -lastApplied: AtomicLong
    -leaderDiskMatchIndex: AtomicLong
    -lastLeaderContactMs: long
    -snapshotInProgress: boolean
    -leaderTransferTarget: String
    +start()
    +shutdown()
    +submitCommand(cmd): CompletableFuture
    +transferLeadership(targetId): CompletableFuture
    +addServer(id, addr): CompletableFuture
    +removeServer(id): CompletableFuture
    +snapshotNow()
    -startElection()
    -startRealElection(term)
    -becomeLeaderLocked()
    -becomeFollowerLocked(term)
    -replicateTo(peerId)
    -sendInstallSnapshot(peerId, transport)
    -advanceCommitIndex()
    -takeSnapshotAsync()
    -onLeaderDiskSyncComplete(idx, term)
    -checkTransferReadyLocked()
}

class "RaftConfig" as Config {
    +selfId(): String
    +selfPort(): int
    +dataDir(): Path
    +peerAddresses(): Map
    +snapshotThreshold(): int
    +snapshotChunkSize(): int
    +metricsPort(): int
    +rpcTimeouts(): RpcTimeouts
    +majority(): int
    {static} +load(path): RaftConfig
}

class "RpcTimeouts" as Timeouts {
    +requestVoteMs(): long
    +appendEntriesMs(): long
    +installSnapshotMs(): long
    +preVoteMs(): long
    {static} +fromProperties(props): RpcTimeouts
    {static} +defaults(): RpcTimeouts
}

class "RaftMetrics" as Metrics {
    +electionStarted()
    +electionWon()
    +voteGranted()
    +stepDown()
    +entryApplied()
    +snapshotTaken()
    +snapshotInstalled()
    +clientRejected()
    +replicationSent(count)
    +replicationSuccess()
    +replicationFailure()
    +snapshotChunkSent()
    +snapshotChunkReceived()
    +appendEntriesTimer(): Timer
    +requestVoteTimer(): Timer
    +clientSubmitTimer(): Timer
    {static} +noop(): RaftMetrics
}

enum "ServerRole" as Role {
    FOLLOWER
    CANDIDATE
    LEADER
}

class "BerkeleyDbStorage" as BDB
class "InMemoryStorage" as IMS
class "KeyValueStateMachine" as KV
class "GrpcTransport" as GT
class "GrpcTransportFactory" as GTF
class "GrpcTransportServer" as GTS
class "NettyTransport" as NT
class "NettyTransportFactory" as NTF
class "NettyTransportServer" as NTS
class "HadoopTransport" as HT
class "HadoopTransportFactory" as HTF
class "HadoopTransportServer" as HTS
class "TimeoutTransport" as TT

Node .up.|> Handler
Node --> Config
Node --> Storage
Node --> SM
Node --> Factory
Node --> Metrics
Node --> Role
Config --> Timeouts

Storage <|.. BDB
Storage <|.. IMS
SM <|.. KV
Transport <|.. GT
Transport <|.. NT
Transport <|.. HT
Transport <|.. TT
TT --> Transport : delegates
Factory <|.. GTF
Factory <|.. NTF
Factory <|.. HTF
TServer <|.. GTS
TServer <|.. NTS
TServer <|.. HTS

@enduml
