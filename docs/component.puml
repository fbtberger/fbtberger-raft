@startuml
skinparam componentStyle rectangle
skinparam defaultFontSize 11

title System Architecture Overview

package "Raft Node Process" {
    [RaftServer\n(main + CLI)] as Server
    [RaftNode\n(consensus algorithm)] as Node
    [StateMachine\n(KeyValueStateMachine)] as SM
    [RaftStorage\n(BerkeleyDbStorage)] as Storage
    [RaftMetrics\n(Micrometer/Prometheus)] as Metrics

    package "Transport Layer" {
        [RaftTransportServer] as TServer
        [TimeoutTransport\n(per-RPC timeouts)] as Timeout
        [RaftTransport] as TClient

        package "gRPC" {
            [GrpcTransportServer] as GrpcS
            [GrpcTransport] as GrpcC
        }
        package "Netty TCP" {
            [NettyTransportServer] as NettyS
            [NettyTransport] as NettyC
        }
        package "Hadoop RPC" {
            [HadoopTransportServer] as HadoopS
            [HadoopTransport] as HadoopC
        }

        TServer <|.. GrpcS
        TServer <|.. NettyS
        TServer <|.. HadoopS
        TClient <|.. GrpcC
        TClient <|.. NettyC
        TClient <|.. HadoopC
        Timeout --> TClient : delegates
    }

    [RaftClientGrpcService\n(client-facing RPCs)] as ClientSvc

    Server --> Node : start / shutdown\ntransferLeadership
    Node --> SM : apply / takeSnapshot
    Node --> Storage : appendEntries / setTermAndVote
    Node --> Timeout : requestVote / appendEntries\ninstallSnapshot / preVote\ntimeoutNow
    Node --> Metrics : counters / timers / gauges
    TServer --> Node : handleRequestVote\nhandleAppendEntries\nhandleInstallSnapshot\nhandlePreVote\nhandleTimeoutNow
    ClientSvc --> Node : submitCommand\naddServer / removeServer
}

cloud "Other Raft Nodes" as Peers
actor "Client" as Client
database "Prometheus" as Prom

Timeout --> Peers : RPC
TServer <-- Peers : RPC
ClientSvc <-- Client : gRPC
Metrics --> Prom : /metrics HTTP

@enduml
