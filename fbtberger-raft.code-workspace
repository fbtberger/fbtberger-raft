{
  "folders": [
    {
      "path": "."
    }
  ],
  "settings": {
    // Java / Gradle
    "java.configuration.updateBuildConfiguration": "automatic",
    "java.compile.nullAnalysis.mode": "automatic",
    "java.test.defaultConfig": "junit5",
    // Editor
    "editor.tabSize": 4,
    "editor.insertSpaces": true,
    "editor.formatOnSave": true,
    "editor.rulers": [
      120
    ],
    "files.trimTrailingWhitespace": true,
    "files.insertFinalNewline": true,
    // Exclude build output from the file explorer
    "files.exclude": {
      "**/build": true,
      "**/.classpath": true,
      "**/.project": true,
      "**/.settings": true,
      "**/.factorypath": true
    },
    // Protobuf: treat generated sources as read-only
    "files.readonlyInclude": {
      "**/build/generated/**": true
    },
    "java.debug.settings.onBuildFailureProceed": true
  },
  "extensions": {
    "recommendations": [
      // Java language support + debugger + Gradle + test runner
      "vscjava.vscode-java-pack",
      // Individual components (already bundled in vscode-java-pack, listed
      // explicitly so they are installed even when the pack is not)
      "redhat.java",
      "vscjava.vscode-gradle",
      "vscjava.vscode-java-test",
      "vscjava.vscode-java-debug",
      // Protobuf syntax highlighting
      "zxh404.vscode-proto3",
      // Spring IoC / Spring Boot support (bean graph, config file hints)
      "vmware.vscode-spring-boot",
      "vscjava.vscode-spring-initializr"
    ]
  },
  "launch": {
    "version": "0.2.0",
    "configurations": [
      {
        "type": "java",
        "name": "RaftServer — node1",
        "request": "launch",
        "mainClass": "com.fbtberger.raft.RaftServer",
        "projectName": "fbtberger-raft",
        "args": [
          "config/node1.properties"
        ],
        "console": "integratedTerminal"
      },
      {
        "type": "java",
        "name": "RaftServer — node2",
        "request": "launch",
        "mainClass": "com.fbtberger.raft.RaftServer",
        "projectName": "fbtberger-raft",
        "args": [
          "config/node2.properties"
        ],
        "console": "integratedTerminal"
      },
      {
        "type": "java",
        "name": "RaftServer — node3",
        "request": "launch",
        "mainClass": "com.fbtberger.raft.RaftServer",
        "projectName": "fbtberger-raft",
        "args": [
          "config/node3.properties"
        ],
        "console": "integratedTerminal"
      },
      {
        "type": "java",
        "name": "RaftClientDemo",
        "request": "launch",
        "mainClass": "com.fbtberger.raft.client.RaftClientDemo",
        "projectName": "fbtberger-raft",
        "console": "integratedTerminal"
      }
    ]
  }
}
